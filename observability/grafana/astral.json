{
  "uid": "astral-observability",
  "title": "Astral Observabilidade",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Auditoria",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "astral-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT ts AS time, facility, message, payload FROM public.observability_audit_event WHERE $__timeFilter(ts) ORDER BY ts DESC LIMIT 1000",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 2,
      "title": "CPU",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "astral-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, host, used_pct FROM public.metric_cpu WHERE $__timeFilter(ts) ORDER BY ts",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 3,
      "title": "Memoria",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "postgres",
        "uid": "astral-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT ts AS time, host, used_pct FROM public.metric_memory WHERE $__timeFilter(ts) ORDER BY ts",
          "rawQuery": true
        }
      ]
    }
  ]
}
